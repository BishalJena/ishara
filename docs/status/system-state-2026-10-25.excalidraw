      "updated": 1792869510963,
      "link": null,
      "locked": false,
      "index": null,
      "text": "Why it was chosen\n• New word = record a few examples, no training\n• Runs on the phone, ~0.5 s, no internet, free\n• Never guesses: unsure → [?]\n• Good when the SAME person records + signs\n\nOpen question → the probe below:\ncan a vision LLM read signs better?",
      "originalText": "Why it was chosen\n• New word = record a few examples, no training\n• Runs on the phone, ~0.5 s, no internet, free\n• Never guesses: unsure → [?]\n• Good when the SAME person records + signs\n\nOpen question → the probe below:\ncan a vision LLM read signs better?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "u_good",
      "autoResize": true,
      "lineHeight": 1.25
