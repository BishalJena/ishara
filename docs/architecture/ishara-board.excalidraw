  {
   "id": "status-t",
   "type": "text",
   "x": 952,
   "y": 1940.0,
   "width": 585.12,
   "height": 200.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
