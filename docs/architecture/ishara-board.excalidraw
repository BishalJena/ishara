  {
   "id": "rules-t",
   "type": "text",
   "x": 52,
   "y": 1930.0,
   "width": 619.0400000000001,
   "height": 220.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
