   "boundElements": [],
   "updated": 1793088000000,
   "link": null,
   "locked": false,
   "text": "Backend (FastAPI, Heroku)\n\n\u2022 Calls, turns, single-use SEND\n\u2022 Draft: Groq + validator + templates\n\u2022 Briefs and the agent's brain\n   (Groq + rules, every line checked)\n\u2022 Bolna's custom-LLM endpoint\n\u2022 Status webhook, call notes",
   "originalText": "Backend (FastAPI, Heroku)\n\n\u2022 Calls, turns, single-use SEND\n\u2022 Draft: Groq + validator + templates\n\u2022 Briefs and the agent's brain\n   (Groq + rules, every line checked)\n\u2022 Bolna's custom-LLM endpoint\n\u2022 Status webhook, call notes",
   "fontSize": 16,
   "fontFamily": 2,
