# Copy to .env at the repo root and fill in. Never commit .env.
# Heroku: set the same names with `heroku config:set`.

# Shared secret the iOS app / Mac bridge sends as a bearer token.
APP_TOKEN=
# Bolna account API key and the graph agent created from backend/bolna/agent.json.
BOLNA_API_KEY=
BOLNA_AGENT_ID=
# Bearer token Bolna sends to our /v1/chat/completions custom-LLM endpoint.
CUSTOM_LLM_TOKEN=
# Groq composer (OpenAI-compatible API).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Path A only (backend /tts).
SARVAM_API_KEY=
# Consenting teammates as comma-separated contact_id=+E164 entries, e.g.
# clinic=+910000000001,pharmacy=+910000000002. The app sends only the contact id.
# Calls go nowhere else.
ALLOWED_RECIPIENTS=
# Public HTTPS base URL of the deployed backend (used when registering the custom LLM).
PUBLIC_BASE_URL=
