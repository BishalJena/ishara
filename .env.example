# Copy to .env at the repo root and fill in. Never commit .env.
# Heroku: set the same names with `heroku config:set`.

# Shared secret the iOS app / Mac bridge sends as a bearer token.
APP_TOKEN=
# Bolna account API key and the graph agent created from backend/bolna/agent.json.
BOLNA_API_KEY=
BOLNA_AGENT_ID=
# Registered custom-model name; use a distinct name for an independent backend.
BOLNA_CUSTOM_MODEL=ishara-relay
# Bearer token Bolna sends to our /v1/chat/completions custom-LLM endpoint.
CUSTOM_LLM_TOKEN=
# Secret path segment of Bolna's status webhook (/bolna/webhook/<secret>). Kept separate
# from CUSTOM_LLM_TOKEN because request paths appear in router logs.
BOLNA_WEBHOOK_SECRET=
# Groq composer (OpenAI-compatible API).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Path A only (backend /tts).
SARVAM_API_KEY=
# Consenting teammates as comma-separated contact_id=+E164 entries, e.g.
# clinic=+910000000001,pharmacy=+910000000002. The app sends only the contact id.
# Calls go nowhere else.
ALLOWED_RECIPIENTS=
# Public HTTPS base URL of the deployed backend (used when registering the custom LLM).
PUBLIC_BASE_URL=
# Optional browser signing: path to the unchanged ASL TFLite model on the backend.
# Install the web-recognition extra; browser video stays local, coordinates go here.
WEB_ASL_MODEL_PATH=
# Optional, day-1 spike only: append redacted custom-LLM request shapes as JSON lines.
# Keep the path under the git-ignored backend/artifacts/, e.g. backend/artifacts/llm_shapes.jsonl
CUSTOM_LLM_SHAPE_LOG=

# Optional private directory for finished call recovery notes (24h after last update).
# Keep outside a release folder; leave empty in ephemeral local tests.
CALL_NOTES_DIR=
