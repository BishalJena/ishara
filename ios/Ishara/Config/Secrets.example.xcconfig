// Copy to Secrets.xcconfig in this folder (it is gitignored) and fill in your values.
// Never commit the real file.
//
// `//` starts a comment in xcconfig files, so write the URL as https:/$()/host.
// For a backend on this Mac, the simulator can use http:/$()/127.0.0.1:8000.
ISHARA_BACKEND_URL = https:/$()/your-backend.example.invalid
// The backend's APP_TOKEN value.
ISHARA_APP_TOKEN = replace-with-the-backend-app-token
